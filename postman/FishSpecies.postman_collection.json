{
  "info": { "name": "Fish Species API - QA", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "item": [
    { "name": "Cadastro", "item": [
      { "name": "Cadastrar espécie", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\"commonName\":\"Pirarucu\",\"scientificName\":\"Arapaima gigas\",\"regions\":[\"Bacia Amazônica\"]}"}, "url": "{{baseUrl}}/api/fish" }, "event": [{"listen":"test","script":{"exec":["pm.test('201',()=>pm.response.to.have.status(201));","pm.expect(pm.response.json().success).to.eql(true);"]}}] },
      { "name": "Cadastro inválido", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{}"}, "url": "{{baseUrl}}/api/fish" }, "event": [{"listen":"test","script":{"exec":["pm.test('400',()=>pm.response.to.have.status(400));","pm.expect(pm.response.json().error.code).to.eql('INVALID_SPECIES_DATA');"]}}] }
    ]},
    { "name": "Consulta", "item": [
      { "name": "Listar espécies", "request": { "method": "GET", "url": "{{baseUrl}}/api/fish" }, "event": [{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));","pm.expect(pm.response.json().data).to.be.an('array');"]}}] },
      { "name": "ID inválido", "request": { "method": "GET", "url": "{{baseUrl}}/api/fish/abc" }, "event": [{"listen":"test","script":{"exec":["pm.test('400',()=>pm.response.to.have.status(400));","pm.expect(pm.response.json().error.code).to.eql('INVALID_ID');"]}}] }
    ]},
    { "name": "Identificação", "item": [
      { "name": "Identificar espécie", "request": { "method": "GET", "url": "{{baseUrl}}/api/fish/identify?scientificName=Cichla%20kelberi" }, "event": [{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));","pm.expect(pm.response.json().data.commonName).to.eql('Tucunaré');"]}}] },
      { "name": "Espécie não identificada", "request": { "method": "GET", "url": "{{baseUrl}}/api/fish/identify?scientificName=Testus%20inexistens" }, "event": [{"listen":"test","script":{"exec":["pm.test('404',()=>pm.response.to.have.status(404));","pm.expect(pm.response.json().error.code).to.eql('FISH_NOT_IDENTIFIED');"]}}] }
    ]}
  ]
}
