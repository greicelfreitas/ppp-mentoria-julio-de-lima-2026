{
  "name": "ppp-mentoria-julio-de-lima-2026",
  "version": "1.0.0",
  "description": "API REST e GraphQL para cadastro e identificação de espécies de peixes",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test test/api.test.js test/unit.test.js test/contract.test.js test/graphql.test.js test/e2e.test.js",
    "test:unit": "node --test test/unit.test.js",
    "test:integration": "node --test test/api.test.js",
    "test:contract": "node --test test/contract.test.js",
    "test:graphql": "node --test test/graphql.test.js",
    "test:report": "node --test --test-reporter=junit --test-reporter-destination=reports/node-tests.xml test/api.test.js test/unit.test.js test/contract.test.js",
    "test:e2e": "node --test test/e2e.test.js",
    "audit": "npm audit --omit=dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greicelfreitas/ppp-mentoria-julio-de-lima-2026.git"
  },
