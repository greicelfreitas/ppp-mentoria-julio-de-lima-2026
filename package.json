  "type": "commonjs",
  "dependencies": {
    "ajv": "^8.17.1",
    "express": "^5.1.0",
    "graphql": "^17.0.2",
    "graphql-http": "^1.23.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.7.1"
  },
  "bugs": {
    "url": "https://github.com/greicelfreitas/ppp-mentoria-julio-de-lima-2026/issues"
