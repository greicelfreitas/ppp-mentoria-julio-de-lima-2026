{
  "info": {
    "name": "Fish Species API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Listar espécies",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/fish" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.test('resposta de sucesso padronizada', () => pm.expect(pm.response.json().success).to.eql(true));"] } }]
    },
    {
      "name": "Identificar espécie",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/fish/identify?scientificName=Cichla%20kelberi" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.test('retorna tucunaré', () => pm.expect(pm.response.json().data.commonName).to.eql('Tucunaré'));"] } }]
    },
    {
      "name": "Nome científico não identificado",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/fish/identify?scientificName=Inexistente" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('status 404', () => pm.response.to.have.status(404));", "pm.test('erro padronizado', () => pm.expect(pm.response.json().error.code).to.eql('FISH_NOT_IDENTIFIED'));"] } }]
    }
  ]
}
